HOST=127.0.0.1
PORT=8787

# Local API authentication. Set this before exposing the proxy beyond localhost.
API_KEY=change-me
CORS_ORIGIN=*

UPSTREAM_BASE_URL=https://agent.vlm.run/v1
CHAT_COMPLETIONS_URL=https://agent.vlm.run/v1/chat/completions
# /v1/models fetches this URL on every request, then falls back to MODELS if it fails.
MODEL_ENDPOINT=https://agent.vlm.run/v1/models

DEFAULT_MODEL=vlmrun-orion-2:opus-5
MODELS=vlmrun-orion-2:opus-5

# VLM Run fields from the browser request. Keep secrets in .env, never in source control.
VLM_SESSION_TOKEN=
VLM_SESSION_ID=
VLM_BROWSER_FINGERPRINT=
VLM_TOOLSETS=core,document,image,image-gen,video,viz,web,world-gen
VLM_PREVIEW=true
VLM_ORIGIN=https://chat.vlm.run
VLM_REFERER=https://chat.vlm.run/

# Optional timeout for upstream headers/requests.
UPSTREAM_TIMEOUT_MS=120000
MAX_BODY_BYTES=10485760
